# Copy this file to .env and change the values
# Supabase -> Project -> Connect -> ORMs -> Prisma (copy both lines, put your database password in place of [YOUR-PASSWORD])
# pooled connection used by the app (port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10"
# session connection used for creating tables (port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
# a long random string — generate one with: node -e "console.log(require(\"crypto\").randomBytes(32).toString(\"hex\"))"
SESSION_SECRET="change-me-to-a-long-random-string"

# shown to guardians on the "Coaching e jogajog" page
NEXT_PUBLIC_COACHING_NAME="Shikhon Coaching"
NEXT_PUBLIC_COACHING_PHONE="01700000000"
NEXT_PUBLIC_COACHING_WHATSAPP="8801700000000"
NEXT_PUBLIC_COACHING_ADDRESS="Mirpur, Dhaka"
